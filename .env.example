# Django settings
SECRET_KEY=your-secret-key-here-make-it-long-and-random
DEBUG=false

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Enable secure cookies + proxy HTTPS detection. Turn this on when serving the
# app over HTTPS (e.g. behind a TLS-terminating reverse proxy). It sets
# SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE, and SECURE_PROXY_SSL_HEADER.
# Leave false for local plain-HTTP development. (default: false)
SECURE_COOKIES=false

# =============================================================================
# Pi-hole Connection (Required)
# =============================================================================
# Each Pi-hole instance uses an environment variable prefix.
# Choose a prefix and use it consistently in the variables below; instances are
# auto-discovered from PIHOLE_{PREFIX}_URL entries.
#
# Pattern: PIHOLE_{PREFIX}_URL, PIHOLE_{PREFIX}_PASSWORD, PIHOLE_{PREFIX}_VERIFY_SSL
#
# Example for a "PRIMARY" instance:
PIHOLE_PRIMARY_URL=https://192.168.1.100
PIHOLE_PRIMARY_PASSWORD=your-pihole-admin-password
PIHOLE_PRIMARY_VERIFY_SSL=false

# Example for a second "SECONDARY" instance:
# PIHOLE_SECONDARY_URL=https://192.168.1.101
# PIHOLE_SECONDARY_PASSWORD=your-secondary-pihole-password
# PIHOLE_SECONDARY_VERIFY_SSL=false

# Timezone (e.g., America/New_York, Europe/London).
# Used by Django, APScheduler, and propagated to system TZ for log timestamps.
TIME_ZONE=UTC

# Optional: Enable web UI authentication.
# If REQUIRE_AUTH=true, APP_PASSWORD must be non-empty or the app refuses to
# start (prevents silently serving the UI unauthenticated).
REQUIRE_AUTH=false
APP_PASSWORD=

# Trust the X-Forwarded-For header for the login rate limit's client IP.
# Leave false when the container is exposed directly (the header is spoofable);
# set true only when a trusted reverse proxy sits in front and sets it.
# TRUST_PROXY=false

# =============================================================================
# Notification Settings (Optional)
# =============================================================================
# Enable notifications for backup failures (default: true)
# NOTIFY_ON_FAILURE=true

# Enable notifications for successful backups (default: false)
# NOTIFY_ON_SUCCESS=false

# Enable notifications when Pi-hole is unreachable (default: true)
# NOTIFY_ON_CONNECTION_LOST=true

# --- Discord ---
# NOTIFY_DISCORD_ENABLED=true
# NOTIFY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Slack ---
# NOTIFY_SLACK_ENABLED=true
# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Telegram ---
# NOTIFY_TELEGRAM_ENABLED=true
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# NOTIFY_TELEGRAM_CHAT_ID=-1001234567890

# --- Pushbullet ---
# NOTIFY_PUSHBULLET_ENABLED=true
# NOTIFY_PUSHBULLET_API_KEY=o.xxxxxxxxxxxxx

# --- Home Assistant ---
# NOTIFY_HOMEASSISTANT_ENABLED=true
# NOTIFY_HOMEASSISTANT_URL=http://homeassistant.local:8123
# NOTIFY_HOMEASSISTANT_WEBHOOK_ID=my_webhook_id
# Or use token instead of webhook:
# NOTIFY_HOMEASSISTANT_TOKEN=eyJ0eX...
